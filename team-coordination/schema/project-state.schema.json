{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single project ledger with managed harness metadata",
  "type": "object",
  "required": [
    "version",
    "members",
    "tasks",
    "history",
    "harness"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "members": {
      "type": "object"
    },
    "tasks": {
      "type": "object"
    },
    "history": {
      "type": "array"
    },
    "harness": {
      "type": "object",
      "required": [
        "schema",
        "revision",
        "goal",
        "constraints",
        "decisions",
        "changes",
        "profiles",
        "runs",
        "policy_hash"
      ],
      "properties": {
        "schema": {
          "const": 2
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "goal": {
          "type": "string"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changes": {
          "type": "array"
        },
        "profiles": {
          "type": "object"
        },
        "runs": {
          "type": "object"
        },
        "policy_hash": {
          "type": "string"
        },
        "sessions": {
          "type": "object"
        },
        "controls": {
          "type": "object"
        },
        "handoffs": {
          "type": "object"
        },
        "checkpoint": {
          "type": "object",
          "required": [
            "id",
            "directory",
            "proposal_sha256",
            "approval",
            "source_policy_hash"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "directory": {
              "type": "string"
            },
            "proposal_sha256": {
              "type": "string"
            },
            "approval": {
              "type": "object"
            },
            "source_policy_hash": {
              "type": "string"
            }
          }
        },
        "reworks": {
          "type": "object",
          "description": "Optional immutable request-ID/event-digest receipts for same-owner rework. Original transition is distinct from current task state."
        },
        "diagnostics": {
          "type": "object",
          "description": "Append-only method-bound observations and exact-command permission-recovery submission records preserving failures and scope; native tool authorization remains required."
        },
        "legacy_archives": {
          "type": "object",
          "description": "Exact original-state bytes and hashes; historical only, never active limits."
        },
        "diagnostic_method_seeds": {
          "type": "object",
          "description": "Reviewed actual-run-bound legacy method provenance."
        }
      }
    }
  },
  "$comment": "Descriptive schema. CLI validates operation invariants; this schema is not a proof of runtime or identity. Do not let legacy CLI mutate managed projects. Session control records requested/accepted/configured/runtime evidence and explicit handoff transitions; runtime invariants remain in the managed adapter."
}
