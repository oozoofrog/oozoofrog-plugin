#!/bin/sh
set -eu
script=$0
while [ -L "$script" ]; do
    target=$(/usr/bin/readlink "$script")
    case $target in
        /*) script=$target ;;
        *) script=$(/usr/bin/dirname -- "$script")/$target ;;
    esac
done
skill_dir=$(CDPATH= cd -- "$(/usr/bin/dirname -- "$script")/.." && pwd)
executable="$skill_dir/bin/MacPilot.app/Contents/MacOS/macpilot"
if [ "${MACPILOT_BUILD_FROM_SOURCE:-0}" = 1 ]; then
    "$skill_dir/scripts/build.sh" >&2
else
    "$skill_dir/scripts/install-runtime.sh" >&2
fi
export MACPILOT_SKILL_DIR="$skill_dir"
exec "$executable" "$@"
