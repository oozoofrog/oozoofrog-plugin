#!/usr/bin/env python3
"""Call OpenAI Decisions through the official OpenAI CLI.

Subcommands:
  status                      CLI and credential availability, no API call.
  create [--input FILE] [--image FILE]...
                              Read a request (wrapper or native shape) from
                              stdin or FILE and print the CLI JSON response.

The API key is passed to the child process environment only. It is never
printed, logged, or placed in command-line arguments.
"""
from __future__ import annotations

import argparse
import base64
import json
import math
import os
import re
import shutil
import subprocess
import sys

MODEL = "gpt-6-luna"
OFFICIAL_BASE_URL = "https://api.openai.com/v1"
MIN_CLI_VERSION = (1, 51, 2)
MAX_REQUEST_BYTES = 8 * 1024 * 1024
DEFAULT_TIMEOUT = 60
KEYCHAIN_ENTRIES = (
    ("local.openai-decisions", "openai"),
    ("com.kakao.mac-cu.decisions", "openai"),
)
QUESTION_TYPES = ("predicate", "choice", "score")
IMAGE_TYPES = {
    ".png": "image/png",
    ".jpg": "image/jpeg",
    ".jpeg": "image/jpeg",
    ".gif": "image/gif",
    ".webp": "image/webp",
}
WRAPPER_ONLY_KEYS = ("state", "image_urls", "timeout_seconds")  # never sent to the CLI


class Failure(Exception):
    pass


# ---------------------------------------------------------------- CLI lookup

def openai_bin() -> str | None:
    override = os.environ.get("OPENAI_DECISIONS_OPENAI_BIN")
    if override:
        return override if os.access(override, os.X_OK) else None
    return shutil.which("openai")


def cli_env(extra: dict | None = None) -> dict:
    env = dict(os.environ)
    env["OPENAI_UNTRUSTED_STDIN"] = "1"
    env["OPENAI_CLI_NO_UPDATE_CHECK"] = "1"
    env["OPENAI_CLI_NO_AUTO_UPDATE"] = "1"
    if extra:
        env.update(extra)
    return env


def cli_version(path: str) -> tuple[str | None, tuple | None]:
    try:
        result = subprocess.run(
            [path, "--version"], capture_output=True, text=True, timeout=20,
            env=cli_env(), stdin=subprocess.DEVNULL,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None, None
    text = (result.stdout or result.stderr).strip()
    match = re.search(r"(\d+)\.(\d+)\.(\d+)", text)
    if result.returncode != 0 or not match:
        return text or None, None
    return match.group(0), tuple(int(part) for part in match.groups())


# --------------------------------------------------------------- credentials

def security_bin() -> str:
    return os.environ.get("OPENAI_DECISIONS_SECURITY_BIN") or "/usr/bin/security"


def keychain_has(service: str, account: str) -> bool:
    try:
        result = subprocess.run(
            [security_bin(), "find-generic-password", "-s", service, "-a", account],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL, timeout=20,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0


def keychain_read(service: str, account: str) -> str | None:
    try:
        result = subprocess.run(
            [security_bin(), "find-generic-password", "-s", service, "-a", account, "-w"],
            capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=60,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    value = result.stdout.rstrip("\n")
    return value or None


def credential_source() -> str | None:
    if os.environ.get("OPENAI_API_KEY"):
        return "env:OPENAI_API_KEY"
    for service, account in KEYCHAIN_ENTRIES:
        if keychain_has(service, account):
            return f"keychain:{service}/{account}"
    return None


def normalized_base(url: str) -> str:
    return url.strip().rstrip("/")


def resolve_credentials() -> tuple[dict, str]:
    """Return child-environment additions and a source label (no secret)."""
    if os.environ.get("OPENAI_API_KEY"):
        return {}, "env:OPENAI_API_KEY"
    custom = os.environ.get("OPENAI_BASE_URL")
    # Check the origin before touching Keychain so a refused request never reads the secret.
    if custom and normalized_base(custom) != OFFICIAL_BASE_URL:
        raise Failure(
            "OPENAI_API_KEY is unset and Keychain credentials are only sent to "
            f"{OFFICIAL_BASE_URL}; unset the custom OPENAI_BASE_URL or set OPENAI_API_KEY"
        )
    for service, account in KEYCHAIN_ENTRIES:
        key = keychain_read(service, account)
        if not key:
            continue
        return (
            {"OPENAI_API_KEY": key, "OPENAI_BASE_URL": OFFICIAL_BASE_URL},
            f"keychain:{service}/{account}",
        )
    raise Failure(
        "no OpenAI API key: set OPENAI_API_KEY through a secret manager or store it in "
        "Keychain service local.openai-decisions, account openai"
    )


# ------------------------------------------------------------------ requests

def fail_if(condition: bool, message: str) -> None:
    if condition:
        raise Failure(message)


def validate_questions(questions) -> None:
    fail_if(not isinstance(questions, list) or not 1 <= len(questions) <= 400,
            "questions must be a list of 1-400 items")
    names = set()
    for index, question in enumerate(questions):
        where = f"questions[{index}]"
        fail_if(not isinstance(question, dict), f"{where} must be an object")
        name = question.get("name")
        fail_if(not isinstance(name, str) or not name, f"{where}.name must be a non-empty string")
        fail_if(name in names, f"duplicate question name: {name}")
        names.add(name)
        kind = question.get("type")
        fail_if(kind not in QUESTION_TYPES, f"{where}.type must be predicate, choice, or score")
        instructions = question.get("instructions")
        fail_if(not isinstance(instructions, str) or not instructions.strip(),
                f"{where}.instructions must be a non-empty string")
        if kind == "choice":
            choices = question.get("choices")
            fail_if(not isinstance(choices, list) or not 2 <= len(choices) <= 255,
                    f"{where}.choices must have 2-255 items")
            values = []
            for choice in choices:
                fail_if(not isinstance(choice, dict) or not isinstance(choice.get("value"), (str, bool)),
                        f"{where}.choices items need a string or boolean value")
                fail_if(choice["value"] in values, f"{where}.choices values must be unique")
                values.append(choice["value"])
        if kind == "score":
            levels = question.get("levels")
            fail_if(not isinstance(levels, list) or not 2 <= len(levels) <= 10,
                    f"{where}.levels must have 2-10 items")
            for level in levels:
                fail_if(not isinstance(level, dict) or not isinstance(level.get("label"), str),
                        f"{where}.levels items need a string label")


def image_data_url(path: str) -> str:
    fail_if(not os.path.isabs(path), f"--image needs an absolute path: {path}")
    mime = IMAGE_TYPES.get(os.path.splitext(path)[1].lower())
    fail_if(mime is None, f"unsupported image type: {path}")
    try:
        with open(path, "rb") as handle:
            data = handle.read()
    except OSError as error:
        raise Failure(f"cannot read image {path}: {error.strerror}")
    return f"data:{mime};base64,{base64.b64encode(data).decode('ascii')}"


def state_content(state) -> list:
    if isinstance(state, str):
        fail_if(not state.strip(), "state must not be empty")
        return [{"type": "input_text", "text": state}]
    if isinstance(state, list):
        state = {"items": state}
    fail_if(not isinstance(state, dict), "state must be text, a JSON object, or a JSON array")
    return [{"type": "input_json", "data": state}]


def with_images(native_input, images: list):
    if not images:
        return native_input
    parts = [{"type": "input_image", "image_url": url} for url in images]
    if isinstance(native_input, str):
        return [{"role": "user", "content": [{"type": "input_text", "text": native_input}] + parts}]
    fail_if(not isinstance(native_input, list), "input must be text or a message list")
    for message in reversed(native_input):
        if isinstance(message, dict) and message.get("role") == "user" and isinstance(message.get("content"), list):
            message["content"].extend(parts)
            return native_input
    return native_input + [{"role": "user", "content": parts}]


def build_request(raw: dict, image_paths: list) -> tuple[dict, int]:
    fail_if(not isinstance(raw, dict), "request must be a JSON object")
    timeout = raw.get("timeout_seconds", DEFAULT_TIMEOUT)
    fail_if(isinstance(timeout, bool) or not isinstance(timeout, (int, float))
            or not math.isfinite(timeout) or not 1 <= timeout <= 300,
            "timeout_seconds must be 1-300")
    urls = raw.get("image_urls") or []
    fail_if(not isinstance(urls, list) or not all(isinstance(u, str) for u in urls),
            "image_urls must be a list of strings")
    for url in urls:
        fail_if(not re.match(r"^(https?://|data:image/)", url),
                "image_urls must be HTTP(S) or base64 data URLs")
    images = list(urls) + [image_data_url(path) for path in image_paths]

    if "state" in raw:
        fail_if("input" in raw, "use either state (wrapper) or input (native), not both")
        content = state_content(raw["state"])
        if images and content[0]["type"] == "input_text":
            native_input = [{"role": "user", "content": content}]
            native_input = with_images(native_input, images)
        elif content[0]["type"] == "input_text":
            native_input = content[0]["text"]
        else:
            native_input = with_images([{"role": "user", "content": content}], images)
    else:
        fail_if("input" not in raw, "request needs state (wrapper) or input (native)")
        native_input = with_images(raw["input"], images)
    # Other request fields (questions, prompt_cache_key, prompt_cache_options,
    # safety_identifier, ...) pass through unchanged in both shapes.
    request = {k: v for k, v in raw.items() if k not in WRAPPER_ONLY_KEYS}
    request.setdefault("model", MODEL)
    request["input"] = native_input
    fail_if(request["model"] != MODEL, f"model must be {MODEL}")
    validate_questions(request.get("questions"))
    return request, int(math.ceil(timeout))


# ---------------------------------------------------------------- commands

def command_status(_args) -> int:
    path = openai_bin()
    version_text, version = cli_version(path) if path else (None, None)
    report = {
        "openai_cli": path,
        "openai_cli_version": version_text,
        "openai_cli_supported": bool(version and version >= MIN_CLI_VERSION),
        "minimum_cli_version": ".".join(map(str, MIN_CLI_VERSION)),
        "credential_source": credential_source(),
        "model": MODEL,
        "api_checked": False,
    }
    print(json.dumps(report, indent=2))
    return 0 if report["openai_cli_supported"] and report["credential_source"] else 1


def redact(data: bytes, secret: str) -> bytes:
    """Remove the credential if the CLI or API echoes it back (for example in a 401 error)."""
    if not secret:
        return data
    return data.replace(secret.encode("utf-8"), b"[REDACTED]")


def command_create(args) -> int:
    if args.input:
        fail_if(not os.path.isabs(args.input), "--input needs an absolute path")
        try:
            with open(args.input, "rb") as handle:
                payload = handle.read(MAX_REQUEST_BYTES + 1)
        except OSError as error:
            raise Failure(f"cannot read {args.input}: {error.strerror}")
    else:
        fail_if(sys.stdin.isatty(), "pass the request JSON on stdin or with --input")
        payload = sys.stdin.buffer.read(MAX_REQUEST_BYTES + 1)
    fail_if(len(payload) > MAX_REQUEST_BYTES, "request exceeds 8 MiB")
    try:
        raw = json.loads(payload.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise Failure(f"request is not valid JSON: {error}")
    request, timeout = build_request(raw, args.image or [])
    body = json.dumps(request, ensure_ascii=False).encode("utf-8")
    fail_if(len(body) > MAX_REQUEST_BYTES, "request with images exceeds 8 MiB")

    path = openai_bin()
    fail_if(not path, "official OpenAI CLI not found; install with "
            "`brew install --cask openai/tools/openai`")
    _, version = cli_version(path)
    fail_if(not version or version < MIN_CLI_VERSION,
            "OpenAI CLI 1.51.2 or later is required (check `openai --version`)")
    extra, _source = resolve_credentials()

    try:
        result = subprocess.run(
            [path, "decisions", "create", "--format", "json"],
            input=body, capture_output=True, timeout=timeout, env=cli_env(extra),
        )
    except subprocess.TimeoutExpired:
        raise Failure(f"request timed out after {timeout}s; not retried because the "
                      "first call may already have incurred usage")
    except OSError as error:
        raise Failure(f"cannot run {path}: {error.strerror}")
    secret = extra.get("OPENAI_API_KEY") or os.environ.get("OPENAI_API_KEY") or ""
    sys.stdout.buffer.write(redact(result.stdout, secret))
    sys.stdout.buffer.flush()
    if result.returncode != 0:
        sys.stderr.buffer.write(redact(result.stderr, secret))
        raise Failure(f"openai decisions create failed with exit code {result.returncode}")
    return 0


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="openai-decisions", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("status", help="check CLI and credential availability without an API call")
    create = sub.add_parser("create", help="send a Decisions request")
    create.add_argument("--input", help="absolute path to a request JSON file (default: stdin)")
    create.add_argument("--image", action="append", help="absolute path to an image; repeatable")
    args = parser.parse_args(argv)
    try:
        return command_status(args) if args.command == "status" else command_create(args)
    except Failure as error:
        print(f"openai-decisions: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
