          "product",
          "architecture",
          "sync",
          "reader",
          "performance",
          "verification",
          "release",
          "decisions",
          "issues",
          "glossary"
        ]
      },
      "lists": [
        "sources",
        "tags"
      ]
    },
    "retro": {
      "required": [
        "date",
        "period"
      ]
    },
    "chronicle": {
      "required": []
    },
    "home": {
      "required": []
    },
    "guide": {
      "required": []
    },
    "inbox": {
      "required": []
    }
