  "application_log": {
    "headings": [
      "적용 기록",
      "Applications"
    ],
    "effect_columns": [
      "효과",
      "Effect"
    ],
    "effect_values": {
      "있음": "yes",
      "없음": "no",
      "모름": "unknown",
      "yes": "yes",
      "no": "no",
      "unknown": "unknown",
      "미적용": "missed",
      "missed": "missed"
    }
  },
  "evidence_fields": {
    "episode": [
      "evidence"
    ],
    "knowledge": [
      "sources"
    ]
  },
  "memory_prefixes": [
    "메모리",
    "memory"
