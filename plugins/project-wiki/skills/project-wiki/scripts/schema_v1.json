          "main-session",
          "delegated",
          "mixed"
        ]
      },
      "lists": [
        "lessons",
        "evidence",
        "tags"
      ],
      "links": [
        "lessons"
      ]
    },
    "lesson": {
      "required": [
        "audience",
        "kind",
        "status",
        "basis",
        "first_seen",
        "last_seen",
        "applied",
        "worked"
      ],
      "enums": {
        "audience": [
          "user",
          "agent",
          "both"
        ],
        "kind": [
          "instruction",
          "response",
          "technical",
          "process"
        ],
        "status": [
          "candidate",
          "adopted",
          "encoded",
          "retired"
        ],
        "basis": [
          "success",
          "failure",
          "mixed"
        ]
      },
      "integers": [
        "applied",
        "worked",
        "missed"
      ],
      "lists": [
        "episodes",
        "tags",
        "aliases",
        "projects"
      ],
      "links": [
        "episodes"
      ]
    },
    "knowledge": {
      "required": [
        "area",
        "verified"
