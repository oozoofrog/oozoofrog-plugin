{
  "name": "winpilot",
  "version": "0.5.1",
  "description": "Windows 앱·게임을 WGC·UIA로 관찰하고 화면 안내가 있는 마우스·키보드로 조작한다. WinPilot 또는 windows-pilot 요청, 창 제어와 UIA가 없는 앱 조작에 사용한다. 사용자 입력·중지 버튼으로 전경 작업을 취소한다.",
  "author": {
    "name": "oozoofrog",
    "url": "https://github.com/oozoofrog"
  },
  "repository": "https://github.com/oozoofrog/oozoofrog-plugin",
  "mcpServers": {
    "winpilot": {
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-File",
        "${CLAUDE_PLUGIN_ROOT}/skills/winpilot/scripts/install-runtime.ps1",
        "-Stdio"
      ],
      "cwd": "${CLAUDE_PLUGIN_ROOT}"
    }
  }
}
